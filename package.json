{
  "name": "@gang-of-beads/pi-updater",
  "version": "0.6.0",
  "description": "Codex-style auto-updater for pi. Checks pi and extension packages on startup and prompts to install updates.",
  "type": "module",
  "scripts": {
    "test": "node --unhandled-rejections=strict --test test/*.test.mjs && vitest run tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "author": "Toms clanker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gang-of-Beads/pi-updater.git"
  },
  "homepage": "https://github.com/Gang-of-Beads/pi-updater#readme",
  "bugs": { "url": "https://github.com/Gang-of-Beads/pi-updater/issues" },
  "publishConfig": { "access": "public" },
  "keywords": [
    "pi-package",
    "pi-extension",
    "update"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://github.com/user-attachments/assets/b34ca10f-1baf-4f4c-9f14-414a5b814112"
  },
  "files": [
    "index.ts",
    "model-updates.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^25.3.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}